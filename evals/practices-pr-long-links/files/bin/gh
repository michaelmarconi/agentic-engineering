#!/usr/bin/env bash
# Stand-in for the GitHub command: records the pull request description it is given in
# .pr-body.md, for the graders, and prints the new pull request's address. Nothing is sent.
set -eu
if [ "${1:-}" != pr ] || [ "${2:-}" != create ]; then
  echo "bin/gh: only 'pr create' is available here" >&2
  exit 1
fi
shift 2
body=""
while [ $# -gt 0 ]; do
  case "$1" in
    -b|--body) body="$2"; shift 2 ;;
    --body=*) body="${1#--body=}"; shift ;;
    -F|--body-file)
      if [ "$2" = - ]; then body="$(cat)"; else body="$(cat "$2")"; fi; shift 2 ;;
    --body-file=*) f="${1#--body-file=}"; if [ "$f" = - ]; then body="$(cat)"; else body="$(cat "$f")"; fi; shift ;;
    *) shift ;;
  esac
done
printf '%s\n' "$body" >> .pr-body.md
echo "https://github.com/example/mailgate/pull/7"
